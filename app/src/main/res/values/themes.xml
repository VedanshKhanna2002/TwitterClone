<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Application Theme -->
    <style name="Base.Theme.TwitterClone" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/my_light_primary</item>
        <item name="colorOnPrimary">@color/my_light_on_primary</item>

        <!-- Override default button style -->
        <item name="buttonStyle">@style/CustomFlatButton</item>
    </style>

    <!-- Application Theme -->
    <style name="Theme.TwitterClone" parent="Base.Theme.TwitterClone" />

    <!-- Flat, gray-style button -->
    <style name="CustomFlatButton" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">#DDDDDD</item> <!-- light gray -->
        <item name="android:textColor">#000000</item> <!-- black text -->
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">0dp</item> <!-- remove roundness -->
        <item name="android:stateListAnimator">@null</item> <!-- remove elevation animation -->
    </style>

</resources>
